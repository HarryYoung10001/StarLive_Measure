{
  "schema_version": 1,
  "name": "udp_echo_rtt",
  "workload": {
    "kind": "udp_echo_rtt",
    "direction": "uplink",
    "duration_s": 150,
    "interval_s": 0.01,
    "payload_bytes": 1200,
    "timeout_ms": 2000
  },
  "roles": {
    "required": ["udp_echo_phone"],
    "optional": []
  },
  "icmp": {"enabled": false},
  "server": {
    "port": 5001,
    "tcpdump": {"enabled": false, "interface": "auto", "snaplen": 256}
  }
}
