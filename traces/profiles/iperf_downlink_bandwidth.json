{
  "schema_version": 1,
  "name": "iperf_downlink_bandwidth",
  "workload": {
    "kind": "iperf3",
    "direction": "downlink",
    "rate": "100M",
    "duration_s": 150,
    "interval_s": 0.2,
    "payload_bytes": 1200
  },
  "roles": {
    "required": ["udp_receiver"],
    "optional": ["icmp_phone"]
  },
  "icmp": {
    "enabled": true,
    "interval_s": 0.2
  },
  "server": {
    "port": 5201,
    "tcpdump": {
      "enabled": false,
      "interface": "auto",
      "snaplen": 256
    }
  }
}
