    "optional": []
  },
  "icmp": {
    "enabled": true,
    "interval_s": 0.2
  },
  "server": {
    "port": 5201,
    "tcpdump": {
      "enabled": false,
      "interface": "auto",
      "snaplen": 256
    }
  }
}
